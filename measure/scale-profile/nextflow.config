params {
    store        = ''  // members buckets of the release, an absolute glob
    rungs        = '100000,1000000,10000000,100000000'  // proteins per nested sample
    ks           = '5,6,7,8,9,11,13'
    queries      = 2000     // held-out proteins aligned to each rung
    query_pool   = 200000   // proteins kept out of every rung, queries drawn from them
    diamond_args = '--more-sensitive --max-target-seqs 0 --id 30 --query-cover 50'
    outdir       = 'results'
    venv         = ''       // kmer-functional-profiler's .venv: numpy and polars
}

process {
    errorStrategy = { task.exitStatus in 137..140 ? 'retry' : 'finish' }
    maxRetries    = 2
    withLabel: 'process_low' { cpus = 1; memory = 2.GB; time = 1.h }
    withLabel: 'process_medium' {  // one bucket, or a rung's tables one bucket at a time
        cpus   = 4
        memory = { 64.GB * task.attempt }
        time   = { 12.h * task.attempt }
    }
    withLabel: 'process_high' {  // about 2 x 10^8 k-mers counted
        cpus   = 4
        memory = { 96.GB * task.attempt }
        time   = { 48.h * task.attempt }
    }
    withLabel: 'process_align' {  // the largest rung, 10^8 proteins
        cpus   = 32
        memory = { 256.GB * task.attempt }
        time   = { 48.h * task.attempt }
    }
}

trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/trace.tsv"
    fields    = 'task_id,hash,name,status,exit,cpus,realtime,%cpu,peak_rss'
}

profiles {
    slurm { process.executor = 'slurm' }
    docker {  // ALIGN only: DIAMOND; biocontainers are amd64 only
        docker.enabled    = true
        docker.runOptions = '--platform linux/amd64'
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }
    test {  // a local members table: one job at a time, two threads
        params.rungs       = '1000,5000,20000,60000'
        params.ks          = '5,7,9'
        params.queries     = 100
        params.query_pool  = 2000
        params.outdir      = 'results-test'
        trace.file         = 'results-test/trace.tsv'
        executor.queueSize = 1
        env.RAYON_NUM_THREADS  = '2'
        env.POLARS_MAX_THREADS = '2'
        process {
            withLabel: 'process_low' { cpus = 1; memory = 2.GB; time = 10.m }
            withLabel: 'process_medium' { cpus = 2; memory = 6.GB; time = 30.m }
            withLabel: 'process_high' { cpus = 2; memory = 6.GB; time = 30.m }
            withLabel: 'process_align' { cpus = 2; memory = 6.GB; time = 30.m }
        }
    }
}
